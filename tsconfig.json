{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "lib": ["ESNext", "DOM", "ScriptHost"],
        "strict": true,
        "esModuleInterop": true,
        "allowJs": true,
        // "node" (node10) was removed in TypeScript 7; the sources are bundled by rollup.
        "moduleResolution": "bundler",
        "sourceMap": false,
        "declaration": true,
        "declarationMap": true,
        "declarationDir": "./lib",
        "outDir": "./lib",
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "noImplicitOverride": true,
        "rootDir": "./src",
    },
    "include": ["./src", "./typings", "./docs-source"]
}
