{
    "name": "@pixi/ui",
    "version": "2.4.1",
    "description": "It is a library that contains commonly used UI components, that are extensible to allow them to be used in any project",
    "homepage": "https://github.com/pixijs/ui",
    "bugs": "https://github.com/pixijs/ui/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pixijs/ui.git"
    },
    "license": "MIT",
    "author": "PixiJS Team",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.mjs",
            "require": "./lib/index.js"
        },
        "./input": {
            "types": "./lib/input/index.d.ts",
            "import": "./lib/input/Input.mjs",
            "require": "./lib/input/Input.js"
        },
        "./Button": {
            "types": "./lib/Button.d.ts",
            "import": "./lib/Button.mjs",
            "require": "./lib/Button.js"
        },
        "./CheckBox": {
            "types": "./lib/CheckBox.d.ts",
            "import": "./lib/CheckBox.mjs",
            "require": "./lib/CheckBox.js"
        },
        "./CircularProgressBar": {
            "types": "./lib/CircularProgressBar.d.ts",
            "import": "./lib/CircularProgressBar.mjs",
            "require": "./lib/CircularProgressBar.js"
        },
        "./Dialog": {
            "types": "./lib/Dialog.d.ts",
            "import": "./lib/Dialog.mjs",
            "require": "./lib/Dialog.js"
        },
        "./DoubleSlider": {
            "types": "./lib/DoubleSlider.d.ts",
            "import": "./lib/DoubleSlider.mjs",
            "require": "./lib/DoubleSlider.js"
        },
        "./Drawer": {
            "types": "./lib/Drawer.d.ts",
            "import": "./lib/Drawer.mjs",
            "require": "./lib/Drawer.js"
        },
        "./FancyButton": {
            "types": "./lib/FancyButton.d.ts",
            "import": "./lib/FancyButton.mjs",
            "require": "./lib/FancyButton.js"
        },
        "./List": {
            "types": "./lib/List.d.ts",
            "import": "./lib/List.mjs",
            "require": "./lib/List.js"
        },
        "./MaskedFrame": {
            "types": "./lib/MaskedFrame.d.ts",
            "import": "./lib/MaskedFrame.mjs",
            "require": "./lib/MaskedFrame.js"
        },
        "./ProgressBar": {
            "types": "./lib/ProgressBar.d.ts",
            "import": "./lib/ProgressBar.mjs",
            "require": "./lib/ProgressBar.js"
        },
        "./RadioGroup": {
            "types": "./lib/RadioGroup.d.ts",
            "import": "./lib/RadioGroup.mjs",
            "require": "./lib/RadioGroup.js"
        },
        "./ScrollBox": {
            "types": "./lib/ScrollBox.d.ts",
            "import": "./lib/ScrollBox.mjs",
            "require": "./lib/ScrollBox.js"
        },
        "./Select": {
            "types": "./lib/Select.d.ts",
            "import": "./lib/Select.mjs",
            "require": "./lib/Select.js"
        },
        "./Slider": {
            "types": "./lib/Slider.d.ts",
            "import": "./lib/Slider.mjs",
            "require": "./lib/Slider.js"
        },
        "./Switcher": {
            "types": "./lib/Switcher.d.ts",
            "import": "./lib/Switcher.mjs",
            "require": "./lib/Switcher.js"
        },
        "./utils/Signal": {
            "types": "./lib/utils/Signal.d.ts",
            "import": "./lib/utils/Signal.mjs",
            "require": "./lib/utils/Signal.js"
        },
        "./package.json": "./package.json"
    },
    "main": "lib/index.js",
    "module": "lib/index.mjs",
    "types": "lib/index.d.ts",
    "files": [
        "lib/",
        "dist/"
    ],
    "scripts": {
        "start": "npm i && npm run storybook",
        "build": "xs build && node scripts/build-umd.mjs",
        "clean": "xs clean",
        "deploy": "xs deploy",
        "docs": "xs docs && npm run storybook:build",
        "lint": "xs lint --max-warnings 0",
        "lint:fix": "xs lint --fix",
        "prepare": "husky install",
        "release": "npm i && xs bump && npm run build && xs docs,publish,git-push",
        "serve": "xs serve",
        "storybook": "storybook dev -p 6006",
        "storybook:build": "storybook build --output-dir docs/storybook",
        "test": "npx jest --silent --passWithNoTests",
        "test:coverage": "npx jest --coverage",
        "types": "xs types",
        "watch": "xs watch"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.{ts,js,mjs}": [
            "npm run lint:fix --",
            "npm run types"
        ],
        "src/*.{ts,js,mjs}": [
            "npm run test"
        ],
        "tests/components/*.test.ts": [
            "npm run test"
        ]
    },
    "extensionConfig": {
        "lint": [
            "."
        ],
        "docsName": "PixiUI",
        "docsTitle": "PixiUI",
        "docsDescription": "API Documentation for UI components made with PixiJS",
        "docsKeyword": "PixiJS, UI, components",
        "globals": {
            "tweedle.js": "tweedle_js"
        }
    },
    "peerDependencies": {
        "pixi.js": "^8.6.2"
    },
    "dependencies": {
        "tweedle.js": "^2.1.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.28.0",
        "@babel/preset-typescript": "^7.27.1",
        "@pixi/extension-scripts": "^2.4.1",
        "@pixi/storybook-renderer": "^1.0.0",
        "@pixi/storybook-webpack5": "^1.0.0",
        "@storybook/addon-essentials": "^8.6.18",
        "@storybook/addon-interactions": "^8.6.18",
        "@storybook/addon-links": "^8.6.18",
        "@storybook/addon-storysource": "^8.6.18",
        "@storybook/test": "^8.6.18",
        "@storybook/types": "^8.6.18",
        "@types/babel__core": "^7.20.5",
        "@types/jest": "^29.5.12",
        "@types/node": "^18.19.120",
        "eslint": "^8.57.0",
        "eslint-plugin-jsdoc": "^51.4.1",
        "eslint-plugin-no-mixed-operators": "^1.1.1",
        "husky": "^9.1.7",
        "jest": "^30.0.5",
        "jest-canvas-mock": "^2.5.2",
        "jest-environment-jsdom": "^30.0.5",
        "jest-raw-loader": "^1.0.1",
        "lint-staged": "^16.1.5",
        "pixi.js": "^8.6.2",
        "storybook": "^8.6.18",
        "ts-jest": "^29.4.1",
        "typescript": "^5.8.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
